<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Whoever is holding the microphone is having a good time regardless; this
       is what it does to everyone else in the room. Which one a colonist gets
       depends on how good the singer is, what they think of them, and a fixed
       streak of taste, so the same person reacts the same way every time. -->

  <ThoughtDef>
    <defName>EI_EnjoyedKaraoke</defName>
    <durationDays>0.4</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.7</stackedEffectMultiplier>
    <stages>
      <li>
        <label>enjoyed the singing</label>
        <description>Somebody has been murdering a song at the top of their lungs, and honestly, it was the best thing that happened all day.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>EI_EnduredKaraoke</defName>
    <durationDays>0.4</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.7</stackedEffectMultiplier>
    <stages>
      <li>
        <label>had to listen to that</label>
        <description>Somebody has been murdering a song at the top of their lungs and there is nowhere in this room to go.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Given to everyone who put a piece in, when the last one goes in. -->
  <ThoughtDef>
    <defName>EI_FinishedJigsaw</defName>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>finished a jigsaw</label>
        <description>Every one of those pieces is where it belongs now, and I know exactly which bits of sky were mine.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>


  <!-- Everyone within earshot of the stump, judged the way karaoke is: the
       teller's social skill, what the listener thinks of them, and a fixed
       streak of taste. -->
  <ThoughtDef>
    <defName>EI_EnjoyedStory</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.7</stackedEffectMultiplier>
    <stages>
      <li>
        <label>a good story by the fire</label>
        <description>Someone told a story tonight, and for a while nobody was thinking about raids or rations or anything else at all.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>EI_SatThroughStory</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.7</stackedEffectMultiplier>
    <stages>
      <li>
        <label>sat through a rambling story</label>
        <description>It went on and on. There was a thrumbo in it at some point, I think.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>

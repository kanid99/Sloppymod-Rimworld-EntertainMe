<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The arcade tables' sounds. The clips are synthesised by
       Source/SoundGen/generate_sounds.py - cabinets of this kind bleeped
       because they were built from oscillators, so a generated sound is the
       real article rather than a stand-in.

       Everything here is meant to be tuned by ear: volumeRange is how loud
       (vanilla's own one-shots mostly sit between 15 and 30), pitchRange is a
       random spread so repeats do not sound mechanical, and distRange is how
       far away a colonist - or the camera - can hear it. The clips differ in
       how dense they are, so the volumes are set to even out how loud they
       seem rather than how loud the files are. -->

  <!-- Ore Rush: the miner's pick taking a piece of ore. -->
  <SoundDef>
    <defName>EI_OreRushDig</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>EntertainingIdeas/Arcade/OreRushDig</clipPath>
          </li>
        </grains>
        <volumeRange>15~15</volumeRange>
        <pitchRange>0.92~1.08</pitchRange>
        <distRange>0~30</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Ore Rush: a round of the tunnel cleared. -->
  <SoundDef>
    <defName>EI_OreRushSeam</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>

<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================ Shared base ============================ -->

  <ThingDef Name="EI_JoyBuildingBase" ParentName="BuildingBase" Abstract="True">
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <socialPropernessMatters>true</socialPropernessMatters>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsJoy</li>
    </thingCategories>
    <designationCategory>Joy</designationCategory>
    <statBases>
      <Flammability>1.0</Flammability>
    </statBases>
  </ThingDef>

  <!-- ===================== 1. Knucklebones (neolithic) ==================== -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_KnuckleboneMat</defName>
    <label>knucklebone mat</label>
    <description>A pegged-out hide scattered with polished animal knuckles and a handful of wager stones. Players take turns casting the bones, calling the count, and losing tomorrow's meat ration to someone with better luck. It asks nothing of a colony's technology - only somewhere dry to sit - which makes it the one thinking game a tribe can raise on its first day.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/KnuckleboneMat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
      <damageData>
        <rect>(0.08,0.08,0.84,0.84)</rect>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <fillPercent>0.15</fillPercent>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>3</Mass>
      <Beauty>2</Beauty>
      <JoyGainFactor>0.85</JoyGainFactor>
    </statBases>
    <stuffCategories>
      <li>Leathery</li>
      <li>Fabric</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <building>
      <joyKind>Gaming_Cerebral</joyKind>
    </building>
  </ThingDef>

  <!-- ============== 2. Shadow lantern theater (medieval) ================= -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_ShadowLanternTheater</defName>
    <label>shadow lantern theater</label>
    <description>A stretched linen screen with a lamp behind it and a vaned drum that the flame's own heat keeps slowly turning. Painted panels ride the drum and their shadows walk across the cloth: a horse, a rider, geese going over. Nobody has to work it and nobody has to be clever at it. People drift in, sit down, and watch a procession that has been going round for hours.\n\nA whole room can watch at once. Wants a few tiles of clear floor in front of it.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/ShadowLanternTheater</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
      <shadowData>
        <volume>(1.7,0.5,0.5)</volume>
      </shadowData>
    </graphicData>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <fillPercent>0.35</fillPercent>
    <pathCost>45</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
      <Mass>12</Mass>
      <Beauty>8</Beauty>
      <JoyGainFactor>1.1</JoyGainFactor>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <costList>
      <Cloth>30</Cloth>
    </costList>
    <building>
      <joyKind>Social</joyKind>
      <watchBuildingStandDistanceRange>
        <min>2</min>
        <max>5</max>
      </watchBuildingStandDistanceRange>
      <watchBuildingStandRectWidth>5</watchBuildingStandRectWidth>
    </building>
    <placeWorkers>
      <li>PlaceWorker_WatchArea</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <!-- The drum turns on the lamp's draught, so the shadows walk whether or
           not anyone is watching. -->
      <li Class="EntertainingIdeas.CompProperties_AnimatedScreen">
        <framePath>EntertainingIdeas/Buildings/ShadowLanternTheaterPlay</framePath>
        <frameCount>10</frameCount>
        <ticksPerFrame>9</ticksPerFrame>
        <drawSize>(2,1)</drawSize>
        <rotateWithBuilding>true</rotateWithBuilding>
        <requireUser>false</requireUser>
      </li>
    </comps>
  </ThingDef>

  <!-- =================== 3. Pinball machines (industrial) ================= -->

  <ThingDef Name="EI_PinballMachineBase" ParentName="EI_JoyBuildingBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,3)</drawSize>
      <shadowData>
        <volume>(0.75,0.5,2.6)</volume>
      </shadowData>
      <damageData>
        <rectN>(0.1,0.02,0.8,0.96)</rectN>
        <rectS>(0.1,0.02,0.8,0.96)</rectS>
        <rectE>(0.02,0.1,0.96,0.8)</rectE>
        <rectW>(0.02,0.1,0.96,0.8)</rectW>
      </damageData>
    </graphicData>
    <size>(1,3)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <fillPercent>0.5</fillPercent>
    <pathCost>48</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <!-- The cabinet runs three tiles deep; the player stands off the near end,
         at the flippers. Offsets are written north-facing and rotate with the
         building, so a south-facing machine puts its player one tile south. -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,2)</interactionCellOffset>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <building>
      <joyKind>Gaming_Dexterity</joyKind>
      <paintable>true</paintable>
    </building>
    <!-- Def inheritance APPENDS list entries, so anything a variant declares
         for itself must not also live here, or the building ends up with two
         of them. Power differs per table, so each table declares its own. -->
    <comps>
      <li Class="CompProperties_Flickable"/>
      <li Class="EntertainingIdeas.CompProperties_AnimatedScreen">
        <framePath>EntertainingIdeas/Buildings/PinballPlay</framePath>
        <frameCount>8</frameCount>
        <ticksPerFrame>6</ticksPerFrame>
        <drawSize>(1,3)</drawSize>
        <rotateWithBuilding>true</rotateWithBuilding>
        <playJobs>
          <li>EI_Play_Pinball</li>
        </playJobs>
      </li>
    </comps>
    <statBases>
      <Flammability>1.0</Flammability>
      <Mass>90</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="EI_PinballMachineBase">
    <defName>EI_PinballMachine</defName>
    <label>pinball machine</label>
    <description>A solenoid-and-relay amusement table: one steel ball, two flippers, and a slab of glass between the player and a playfield of bumpers that whack the ball back the moment it touches them. The scoring reels clatter loudly enough to be heard three rooms away, which is either charm or grounds for a formal complaint, depending on who you ask.\n\nRewards a steady hand and good timing - regular play trains shooting.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/PinballClassic</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Beauty>6</Beauty>
      <JoyGainFactor>1.25</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>65</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>120</basePowerConsumption>
      </li>
    </comps>
    <researchPrerequisites>
      <li>EI_PinballEngineering</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="EI_PinballMachineBase">
    <defName>EI_PinballMachineBoomalope</defName>
    <label>boomalope blitz pinball</label>
    <description>The same cabinet, rebuilt around a herd-chase theme and a pair of chemfuel flash pots that cough a gout of harmless flame over the backglass on a jackpot. The art is a lurid green boomalope going up like a dropped lamp. Colonists who have actually watched a boomalope go up find this hilarious, horrifying, or both.\n\nThe flash pots draw extra power and make it a rowdier, more memorable table than the standard build.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/PinballBoomalope</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>11000</WorkToBuild>
      <Beauty>9</Beauty>
      <JoyGainFactor>1.35</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Chemfuel>25</Chemfuel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
    </comps>
    <researchPrerequisites>
      <li>EI_PinballEngineering</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="EI_PinballMachineBase">
    <defName>EI_PinballMachineMechRampage</defName>
    <label>mech rampage pinball</label>
    <description>A solid-state table with a microchip scoring brain, a ramp shaped like a downed centipede, and a voice chip that barks threats in mechanoid cant. Tighter shots, harsher tilt sensor, far more satisfying to beat.\n\nThe electronics hold a running high-score table, and colonists will absolutely fight over it.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/PinballMechRampage</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>14000</WorkToBuild>
      <Beauty>7</Beauty>
      <JoyGainFactor>1.4</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>180</basePowerConsumption>
      </li>
    </comps>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>EI_PinballEngineering</li>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="EI_PinballMachineBase">
    <defName>EI_PinballMachineArchotech</defName>
    <label>archotech dreamtable</label>
    <description>A glitterworld pinball cabinet with no ball in it. The table reads the player's hands a half-second before they move and projects a ball that was always going to be exactly where they swing - so every player, however clumsy, walks away convinced they are extraordinary at pinball.\n\nIt is a very expensive, very beautiful lie, and nobody who plays it wants it corrected.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/PinballArchotech</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>22000</WorkToBuild>
      <Beauty>14</Beauty>
      <JoyGainFactor>1.55</JoyGainFactor>
    </statBases>
    <costList>
      <Plasteel>40</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
      <Gold>20</Gold>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(120,228,226,0)</glowColor>
      </li>
    </comps>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>EI_HolographicEntertainment</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============== 6. Cocktail arcade table (industrial) ================ -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_CocktailArcadeTable</defName>
    <label>cocktail arcade table</label>
    <description>A sit-down arcade cabinet with the screen lying face up under a sheet of glass and a joystick at each of two seats. One player runs a little yellow eater around a maze, hoovering pellets while four ghosts hunt them down; the other heckles from across the table and waits their turn. The picture flips between turns so both seats play it the right way up.\n\nSeats two - set a chair on either side. Quick reflexes help, and the ribbing that comes with them is half the point.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/CocktailArcade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
      <shadowData>
        <volume>(0.8,0.35,0.8)</volume>
      </shadowData>
      <damageData>
        <rect>(0.08,0.08,0.84,0.84)</rect>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <fillPercent>0.4</fillPercent>
    <pathCost>50</pathCost>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>11000</WorkToBuild>
      <Mass>35</Mass>
      <Beauty>5</Beauty>
      <JoyGainFactor>1.3</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>55</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <building>
      <joyKind>Gaming_Dexterity</joyKind>
      <paintable>true</paintable>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(120,150,240,0)</glowColor>
      </li>
      <!-- Runs the screen animation while someone is actually playing, and
           only while the table has power. 16 frames at 8 ticks each is one
           lap of the maze every ~2 seconds at normal speed. -->
      <li Class="EntertainingIdeas.CompProperties_AnimatedScreen">
        <framePath>EntertainingIdeas/Buildings/CocktailArcadeScreen</framePath>
        <frameCount>16</frameCount>
        <ticksPerFrame>8</ticksPerFrame>
        <drawSize>(1.15,1.15)</drawSize>
        <playJobs>
          <li>EI_Play_CocktailArcade</li>
        </playJobs>
      </li>
    </comps>
    <researchPrerequisites>
      <li>EI_PinballEngineering</li>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ==================== 7. Massage chair (industrial) ================== -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_MassageChair</defName>
    <label>massage chair</label>
    <description>A heavy reclining chair stuffed with rollers, cams and a small motor that works its way up and down the occupant's spine. It is not subtle and it is not quiet, but twenty minutes in one takes the edge off a week of hauling.\n\nColonists sit in it rather than beside it. Doubles as an ordinary, very comfortable chair when nobody is using it properly.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/MassageChair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
      <shadowData>
        <volume>(0.7,0.4,0.75)</volume>
      </shadowData>
      <damageData>
        <rectN>(0.15,0.1,0.7,0.82)</rectN>
        <rectS>(0.15,0.1,0.7,0.82)</rectS>
        <rectE>(0.1,0.15,0.82,0.7)</rectE>
        <rectW>(0.1,0.15,0.82,0.7)</rectW>
      </damageData>
    </graphicData>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <fillPercent>0.4</fillPercent>
    <pathCost>60</pathCost>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>110</MaxHitPoints>
      <WorkToBuild>7000</WorkToBuild>
      <Mass>30</Mass>
      <Beauty>6</Beauty>
      <Comfort>0.85</Comfort>
      <JoyGainFactor>1.2</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>45</Steel>
      <Cloth>40</Cloth>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <joyKind>Meditative</joyKind>
      <isSittable>true</isSittable>
      <paintable>true</paintable>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>90</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <!-- Rollers and vibration, drawn around the edges of the chair: a pawn
           sitting in it covers the middle. -->
      <li Class="EntertainingIdeas.CompProperties_AnimatedScreen">
        <framePath>EntertainingIdeas/Buildings/MassageChairRollers</framePath>
        <frameCount>8</frameCount>
        <ticksPerFrame>7</ticksPerFrame>
        <drawSize>(1.15,1.15)</drawSize>
        <rotateWithBuilding>true</rotateWithBuilding>
        <playJobs>
          <li>EI_UseMassageChair</li>
        </playJobs>
      </li>
    </comps>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ===================== 4. Hologame pod (spacer) ======================= -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_HologamePod</defName>
    <label>hologame pod</label>
    <description>A waist-high emitter well that throws a board of light above itself and lets one player push the pieces around with their hands. It ships with a few thousand strategy games and generates more when those run out, each one tuned to sit just past the edge of the player's ability.\n\nLosing to it is good for you, apparently. It trains intellectual skill.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/HologamePod</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.9,1.9)</drawSize>
      <shadowData>
        <volume>(0.85,0.3,0.85)</volume>
      </shadowData>
      <damageData>
        <rectN>(0.1,0.1,0.8,0.8)</rectN>
        <rectS>(0.1,0.1,0.8,0.8)</rectS>
        <rectE>(0.1,0.1,0.8,0.8)</rectE>
        <rectW>(0.1,0.1,0.8,0.8)</rectW>
      </damageData>
    </graphicData>
    <uiIconScale>0.55</uiIconScale>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>18000</WorkToBuild>
      <Mass>45</Mass>
      <Beauty>10</Beauty>
      <JoyGainFactor>1.45</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <joyKind>Gaming_Cerebral</joyKind>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(110,220,230,0)</glowColor>
      </li>
    </comps>
    <researchPrerequisites>
      <li>EI_HolographicEntertainment</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ==================== 8. Vista panel (spacer) ======================== -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_VistaPanel</defName>
    <label>vista panel</label>
    <description>A wall-length display showing somewhere with a horizon in it. The feed runs on the local clock - grey dawn, open daylight, a long sunset, then stars - and the panel throws enough light into the room to cast the right colour of shadow at the right hour.\n\nIt is not a window and nobody is fooled for long, but a room with one in it stops feeling quite so much like a hole in the ground. Colonists in the same room hold off cabin fever for longer, though it will never do the job of actually going outside.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/VistaPanel</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1)</drawSize>
      <shadowData>
        <volume>(2.6,0.4,0.3)</volume>
        <offset>(0,0,0.1)</offset>
      </shadowData>
    </graphicData>
    <size>(3,1)</size>
    <tickerType>Rare</tickerType>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <fillPercent>0.3</fillPercent>
    <pathCost>60</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>16000</WorkToBuild>
      <Mass>45</Mass>
      <Beauty>14</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <!-- Colour is overwritten at runtime to match whatever is on screen. -->
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(250,245,225,0)</glowColor>
      </li>
      <li Class="EntertainingIdeas.CompProperties_DayCycleDisplay">
        <ticksPerFrame>14</ticksPerFrame>
        <drawSize>(3,1)</drawSize>
        <phases>
          <li>
            <label>a night sky</label>
            <startDayPercent>0</startDayPercent>
            <framePath>EntertainingIdeas/Buildings/VistaPanelNight</framePath>
            <frameCount>6</frameCount>
            <glowColor>(96,124,200,0)</glowColor>
          </li>
          <li>
            <label>a grey dawn</label>
            <startDayPercent>0.2</startDayPercent>
            <framePath>EntertainingIdeas/Buildings/VistaPanelDawn</framePath>
            <frameCount>6</frameCount>
            <glowColor>(250,196,146,0)</glowColor>
          </li>
          <li>
            <label>open daylight</label>
            <startDayPercent>0.3</startDayPercent>
            <framePath>EntertainingIdeas/Buildings/VistaPanelDay</framePath>
            <frameCount>6</frameCount>
            <glowColor>(250,245,225,0)</glowColor>
          </li>
          <li>
            <label>a long sunset</label>
            <startDayPercent>0.7</startDayPercent>
            <framePath>EntertainingIdeas/Buildings/VistaPanelDusk</framePath>
            <frameCount>6</frameCount>
            <glowColor>(250,172,112,0)</glowColor>
          </li>
          <li>
            <label>a night sky</label>
            <startDayPercent>0.8</startDayPercent>
            <framePath>EntertainingIdeas/Buildings/VistaPanelNight</framePath>
            <frameCount>6</frameCount>
            <glowColor>(96,124,200,0)</glowColor>
          </li>
        </phases>
      </li>
      <!-- Tops the outdoors need up to a ceiling well short of full. -->
      <li Class="EntertainingIdeas.CompProperties_OutdoorsSimulator">
        <maxNeedLevel>0.35</maxNeedLevel>

      </li>
    </comps>
    <researchPrerequisites>
      <li>EI_HolographicEntertainment</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ================ 5. Dreamloop holotheater (ultratech) =============== -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_DreamloopHolotheater</defName>
    <label>dreamloop holotheater</label>
    <description>A bank of five emitters that fills the room in front of it with a shared waking dream - not a picture on a wall, but weather, crowds, and coastline standing in the open floor. Everyone watching gets the same dream, which is why the arguments afterwards are so specific.\n\nA whole room can watch at once, including people lying in bed nearby. It is enormously entertaining and enormously expensive to run.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/DreamloopHolotheater</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,1)</drawSize>
      <shadowData>
        <volume>(2.6,0.5,0.4)</volume>
        <offset>(0,0,0.1)</offset>
      </shadowData>
    </graphicData>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <fillPercent>0.35</fillPercent>
    <pathCost>70</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>42000</WorkToBuild>
      <Mass>120</Mass>
      <Beauty>20</Beauty>
      <JoyGainFactor>1.7</JoyGainFactor>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <Plasteel>80</Plasteel>
      <ComponentSpacer>8</ComponentSpacer>
      <Gold>30</Gold>
    </costList>
    <building>
      <joyKind>Television</joyKind>
      <watchBuildingStandDistanceRange>
        <min>3</min>
        <max>7</max>
      </watchBuildingStandDistanceRange>
      <watchBuildingStandRectWidth>7</watchBuildingStandRectWidth>
    </building>
    <placeWorkers>
      <li>PlaceWorker_WatchArea</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(170,140,240,0)</glowColor>
      </li>
      <!-- Looks for a wall up to six tiles straight ahead and throws the
           stream onto it. Nothing in range means no picture, so face it at
           a wall to get the big screen. -->
      <li Class="EntertainingIdeas.CompProperties_WallProjection">
        <framePath>EntertainingIdeas/Buildings/DreamloopProjection</framePath>
        <frameCount>12</frameCount>
        <ticksPerFrame>10</ticksPerFrame>
        <drawSize>(3,1)</drawSize>
        <projectionRange>6</projectionRange>
      </li>
    </comps>
    <researchPrerequisites>
      <li>EI_DreamloopProjection</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ===================== 9. Soaking tub (medieval) ====================== -->

  <ThingDef ParentName="EI_JoyBuildingBase">
    <defName>EI_SoakingTub</defName>
    <label>soaking tub</label>
    <description>A deep banded barrel with a small firebox slung underneath it. Fill it, light the box, and in half an hour there is enough hot water to put a person back together after a week of hauling rock.\n\nColonists get in rather than sit beside it, and it warms the room while it burns. Runs on wood.</description>
    <graphicData>
      <texPath>EntertainingIdeas/Buildings/SoakingTub</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.15,1.15)</drawSize>
      <shadowData>
        <volume>(0.8,0.4,0.8)</volume>
      </shadowData>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <fillPercent>0.45</fillPercent>
    <pathCost>60</pathCost>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>28</Mass>
      <Beauty>6</Beauty>
      <JoyGainFactor>1.15</JoyGainFactor>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>55</costStuffCount>
    <costList>
      <Steel>20</Steel>
    </costList>
    <building>
      <joyKind>Meditative</joyKind>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>8.0</fuelConsumptionRate>
        <fuelCapacity>20.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>10</heatPerSecond>
        <heatPushMaxTemperature>26</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <!-- The near half of the tub, painted back over whoever is in it. The
           game draws pawns standing on the tile and has no submersion
           rendering, so this waterline is what makes an occupant read as
           being in the water rather than on top of it. -->
      <li Class="EntertainingIdeas.CompProperties_AnimatedScreen">
        <framePath>EntertainingIdeas/Buildings/SoakingTubWater</framePath>
        <frameCount>6</frameCount>
        <ticksPerFrame>16</ticksPerFrame>
        <drawSize>(1.15,1.15)</drawSize>
        <requireUser>false</requireUser>
        <drawOverPawns>true</drawOverPawns>
      </li>
      <!-- Steam sits above the waterline, and only while the firebox is lit. -->
      <li Class="EntertainingIdeas.CompProperties_AnimatedScreen">
        <framePath>EntertainingIdeas/Buildings/SoakingTubSteam</framePath>
        <frameCount>6</frameCount>
        <ticksPerFrame>14</ticksPerFrame>
        <drawSize>(1.15,1.15)</drawSize>
        <requireUser>false</requireUser>
        <requireFuel>true</requireFuel>
        <drawOverPawns>true</drawOverPawns>
      </li>
    </comps>
  </ThingDef>


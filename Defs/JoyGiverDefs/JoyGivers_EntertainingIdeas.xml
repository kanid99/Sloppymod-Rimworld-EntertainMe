  <!-- Ours, so a pool with no water is never offered, a pool whose filter is
       gone still is, and an indoor pool counts even when vanilla would call
       it too cold to swim. -->
  <JoyGiverDef>
    <defName>EI_Swim</defName>
    <giverClass>EntertainingIdeas.JoyGiver_Swim</giverClass>
    <baseChance>3</baseChance>
    <thingDefs>
      <li>EI_PoolFilter</li>
    </thingDefs>
    <jobDef>EI_Swim</jobDef>
    <joyKind>Social</joyKind>
    <requiredCapacities>
      <li>Moving</li>
    </requiredCapacities>
  </JoyGiverDef>

  <!-- Pawns get into the hammock itself, not a chair beside it. -->
  <JoyGiverDef>
    <defName>EI_Lounge</defName>
    <giverClass>EntertainingIdeas.JoyGiver_SitInBuilding</giverClass>
    <baseChance>2.5</baseChance>
    <thingDefs>
      <li>EI_Hammock</li>
    </thingDefs>
    <jobDef>EI_Lounge</jobDef>
    <joyKind>Meditative</joyKind>
  </JoyGiverDef>


  <!-- Vanilla's watch-building giver with a cap: cornhole is a two-player
       game and the throwing area holds more than two. -->
  <JoyGiverDef>
    <defName>EI_Play_Cornhole</defName>
    <giverClass>EntertainingIdeas.JoyGiver_Cornhole</giverClass>
    <baseChance>3</baseChance>
    <desireSit>false</desireSit>
    <thingDefs>
      <li>EI_CornholeBoard</li>
    </thingDefs>
    <jobDef>EI_Play_Cornhole</jobDef>
    <joyKind>Gaming_Dexterity</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>

  <!-- Any number can work on the same puzzle, one per chair pulled up to the
       table, so only the chair is claimed. Written as its own giver for that
       reason: vanilla's sit-adjacent giver reserves the table itself. -->
  <JoyGiverDef>
    <defName>EI_DoJigsaw</defName>
    <giverClass>EntertainingIdeas.JoyGiver_Jigsaw</giverClass>
    <baseChance>2</baseChance>
    <thingDefs>
      <li>EI_JigsawTable</li>
    </thingDefs>
    <jobDef>EI_DoJigsaw</jobDef>
    <joyKind>Gaming_Cerebral</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>


  <!-- The stump has two roles, so two givers: one colonist tells, the rest
       listen - and the listeners' giver only offers the stump while a story
       is actually under way. -->
  <JoyGiverDef>
    <defName>EI_TellStory</defName>
    <giverClass>EntertainingIdeas.JoyGiver_TellStory</giverClass>
    <baseChance>1.5</baseChance>
    <thingDefs>
      <li>EI_StorytellerStump</li>
    </thingDefs>
    <jobDef>EI_TellStory</jobDef>
    <joyKind>Social</joyKind>
    <requiredCapacities>
      <li>Talking</li>
    </requiredCapacities>
  </JoyGiverDef>

  <JoyGiverDef>
    <defName>EI_ListenToStory</defName>
    <giverClass>EntertainingIdeas.JoyGiver_ListenToStory</giverClass>
    <baseChance>4</baseChance>
    <desireSit>true</desireSit>
    <thingDefs>
      <li>EI_StorytellerStump</li>
    </thingDefs>
    <jobDef>EI_ListenToStory</jobDef>

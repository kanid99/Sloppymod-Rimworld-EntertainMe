<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The pool is terrain, not an object. Paint basin tiles in whatever shape
       you want and the filtration unit claims every basin tile connected to
       it, so the pool's size - and with it the water it holds and the power it
       draws - is whatever you drew. The water terrain is not buildable: the
       filter swaps it in as the pool fills, and back out as it drains. -->

  <TerrainDef>
    <defName>EI_PoolBasin</defName>
    <label>pool basin</label>
    <description>Rounded pea gravel set in resin over a waterproof liner, laid in a shallow dish. Dry, it is a hard floor that is slightly unpleasant to walk on barefoot. Connect it to a pool filtration unit and it stops being a floor.\n\nLay as many tiles as you like, in any shape. The filter will take every tile joined to it edge-to-edge.</description>
    <texturePath>EntertainingIdeas/Terrain/PoolBasin</texturePath>
    <!-- Above every natural ground (sand is 350), so soil does not fade over
         the pool's edge; SectionLayer_PoolEdges draws the coping over the
         hard edge this leaves. -->
    <edgeType>Hard</edgeType>
    <renderPrecedence>360</renderPrecedence>
    <pathCost>2</pathCost>
    <statBases>
      <Beauty>1</Beauty>
      <Cleanliness>0.3</Cleanliness>
      <WorkToBuild>320</WorkToBuild>
    </statBases>
    <costList>
      <Steel>3</Steel>
    </costList>
    <designationCategory>Joy</designationCategory>
    <uiOrder>2100</uiOrder>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    </affordances>
    <takeFootprints>true</takeFootprints>
    <layerable>true</layerable>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </TerrainDef>

  <TerrainDef>
    <defName>EI_PoolWater</defName>
    <label>pool water</label>
    <description>Filtered, circulating, chest-deep water over a pebbled floor. Colonists swim in it for recreation. Without a running pump it goes stale: murky first, then foul.</description>
    <texturePath>EntertainingIdeas/Terrain/PoolWater</texturePath>
    <edgeType>Hard</edgeType>
    <renderPrecedence>362</renderPrecedence>
    <!-- Wading is slower than walking, but this is a pool, not a river: it
         must not be so expensive that pawns path all the way around it. -->
    <pathCost>18</pathCost>
    <statBases>
      <Beauty>4</Beauty>
      <Cleanliness>0.4</Cleanliness>
      <WorkToBuild>320</WorkToBuild>
    </statBases>
    <takeSplashes>true</takeSplashes>
    <!-- Whether snow settles on it, and what kind of water it is, are set per
         game version in 1.5/Patches and 1.6/Patches: 1.6 renamed holdSnow to
         holdSnowOrSand and added waterBodyType, and a field the running
         version does not have is an XML error on load. -->
    <takeFootprints>false</takeFootprints>
    <extinguishesFire>true</extinguishesFire>
    <layerable>true</layerable>
    <affordances>
      <li>Light</li>
    </affordances>
    <!-- No designationCategory: this is not something the player lays. The
         filtration unit puts it down as the pool fills and takes it back up
         again as the pool drains. -->
  </TerrainDef>

  <!-- The same water gone bad. The pool swaps between these three as its
       dirt rises with no pump running and falls again once one is. -->
  <TerrainDef>
    <defName>EI_PoolWaterMurky</defName>
    <label>murky pool water</label>
    <description>Pool water that has stood too long without a pump turning it over. Cloudy, greenish, and starting to smell. Colonists will still swim in it.</description>
    <texturePath>EntertainingIdeas/Terrain/PoolWaterMurky</texturePath>
    <edgeType>Hard</edgeType>
    <renderPrecedence>362</renderPrecedence>
    <pathCost>18</pathCost>
    <statBases>
      <Beauty>0</Beauty>
      <Cleanliness>0</Cleanliness>
      <WorkToBuild>320</WorkToBuild>
    </statBases>
    <takeSplashes>true</takeSplashes>
    <takeFootprints>false</takeFootprints>
    <extinguishesFire>true</extinguishesFire>
    <layerable>true</layerable>
    <affordances>
      <li>Light</li>
    </affordances>
  </TerrainDef>

  <TerrainDef>
    <defName>EI_PoolWaterFoul</defName>
    <label>foul pool water</label>
    <description>Stagnant, algae-choked water with a scum on top. Colonists will still swim in it, and some of them will fall ill for it. A running filter will clear it in a couple of days.</description>
    <texturePath>EntertainingIdeas/Terrain/PoolWaterFoul</texturePath>
    <edgeType>Hard</edgeType>
    <renderPrecedence>362</renderPrecedence>
    <pathCost>18</pathCost>
    <statBases>
      <Beauty>-4</Beauty>
      <Cleanliness>-0.6</Cleanliness>
      <WorkToBuild>320</WorkToBuild>
    </statBases>
    <takeSplashes>true</takeSplashes>
    <takeFootprints>false</takeFootprints>
    <extinguishesFire>true</extinguishesFire>
    <layerable>true</layerable>
    <affordances>
      <li>Light</li>
    </affordances>
  </TerrainDef>

</Defs>

<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- What a swim in a foul pool can leave behind: a day or so of stomach
       cramps and vomiting, modelled on food poisoning but shorter and milder.
       Nobody dies of it; it just costs a colonist a bad day. -->
  <HediffDef>
    <defName>EI_SwimmersSickness</defName>
    <label>swimmer's sickness</label>
    <description>A stomach bug from swallowing stagnant pool water. Cramps, nausea and vomiting, clearing up on its own within a day or so.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.8</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>recovering</label>
        <painOffset>0.1</painOffset>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>acute</label>
        <painOffset>0.2</painOffset>
        <vomitMtbDays>0.3</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- After a workout on the fitness equipment: a day of feeling the benefit,
       in the stats that equipment trains. A new workout replaces it rather
       than stacking. -->
  <HediffDef Name="EI_WorkoutBuffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.85, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="EI_WorkoutBuffBase">
    <defName>EI_Pumped</defName>
    <label>pumped</label>
    <description>Fresh from the weight bench. Heavy things feel a little lighter for a while.</description>
    <stages>
      <li>
        <statFactors>
          <CarryingCapacity>1.15</CarryingCapacity>
          <MiningSpeed>1.1</MiningSpeed>
          <ConstructionSpeed>1.05</ConstructionSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="EI_WorkoutBuffBase">
    <defName>EI_GoodStamina</defName>
    <label>good stamina</label>
    <description>Fresh from the exercise bike. Legs and lungs are warmed up, and the day takes a little longer to wear them out.</description>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.05</MoveSpeed>
          <RestFallRateFactor>0.9</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="EI_WorkoutBuffBase">
    <defName>EI_Sharp</defName>
    <label>sharp</label>
    <description>Fresh from the punching bag. Hands quick, footwork light.</description>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>2</MeleeHitChance>
          <MeleeDodgeChance>3</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="EI_WorkoutBuffBase">
    <defName>EI_Limber</defName>
    <label>limber</label>
    <description>Fresh from the bouldering wall. Loose, nimble and a little surer of hand.</description>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.03</MoveSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.03</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>

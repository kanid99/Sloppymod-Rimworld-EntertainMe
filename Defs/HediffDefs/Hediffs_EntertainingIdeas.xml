<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- What a swim in a foul pool can leave behind: a day or so of stomach
       cramps and vomiting, modelled on food poisoning but shorter and milder.
       Nobody dies of it; it just costs a colonist a bad day. -->
  <HediffDef>
    <defName>EI_SwimmersSickness</defName>
    <label>swimmer's sickness</label>
    <description>A stomach bug from swallowing stagnant pool water. Cramps, nausea and vomiting, clearing up on its own within a day or so.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.8</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>recovering</label>
        <painOffset>0.1</painOffset>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>acute</label>
        <painOffset>0.2</painOffset>
        <vomitMtbDays>0.3</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
